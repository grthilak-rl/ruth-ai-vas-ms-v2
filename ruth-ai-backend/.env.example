# Ruth AI Backend Environment Configuration
# Copy this file to .env and fill in the values

# ===== Application =====
RUTH_AI_ENV=development
RUTH_AI_LOG_LEVEL=info
RUTH_AI_LOG_FORMAT=json

# ===== Server =====
HOST=0.0.0.0
PORT=8080

# ===== Database =====
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://ruth:ruth@localhost:5432/ruth_ai
DATABASE_POOL_SIZE=10
DATABASE_POOL_OVERFLOW=5

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ===== VAS Integration =====
VAS_BASE_URL=http://10.30.250.245:8085
VAS_CLIENT_ID=ruth-ai-backend
VAS_CLIENT_SECRET=changeme
VAS_TOKEN_REFRESH_MARGIN_SEC=300

# ===== JWT Authentication =====
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ===== Admin login (Model Management, /api/v1/admin) =====
# Leave unset to disable: admin routes then return 503 "admin not configured"
# and the rest of the API is unaffected. Admin tokens are signed with
# JWT_SECRET_KEY, which must not be the placeholder above.
# Generate the hash with: python scripts/make_admin_hash.py
# Keep it in single quotes; a bcrypt hash contains `$`.
RUTH_ADMIN_USERNAME=
RUTH_ADMIN_PASSWORD_HASH=''
# Optional: comma-separated hosts whose X-Real-IP header is trusted for the
# login rate limit (the nginx frontend). Empty = use the TCP peer address.
RUTH_ADMIN_TRUSTED_PROXY_HOSTS=
